# Supabase project settings: Project Settings > API Keys (dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Never use the secret/service_role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Shared secret for POST /api/revalidate/resume (sent as the x-revalidate-secret header)
RESUME_REVALIDATE_SECRET=generate-a-long-random-string

# Admin page (/admin): only this email can sign in and publish resume versions.
# Must match the email in supabase/migrations/*_resume_versions_admin_insert.sql
ADMIN_EMAIL=you@example.com

# Resume assistant model as provider:model. Supported providers: google, anthropic.
AI_MODEL=google:gemini-3.8-flash
# API key for the provider in AI_MODEL
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
